POSTGRES_USER=auth
POSTGRES_PASSWORD=secret
POSTGRES_DB=authdb
DATABASE_URL=postgres://auth:secret@localhost:5432/authdb?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
SERVER_PORT=8080
# Set to true only for local plain-HTTP development; leave unset/false behind HTTPS.
INSECURE_COOKIES=true
