POSTGRES_USER=auth
POSTGRES_PASSWORD=secret
POSTGRES_DB=authdb
DATABASE_URL=postgres://auth:secret@localhost:5432/authdb?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
SERVER_PORT=8080
# Set to true only for local plain-HTTP development; leave unset/false behind HTTPS.
INSECURE_COOKIES=true

# --- Optional tuning knobs (shown with their defaults) ---
# Rate limits are per minute, per IP, per endpoint.
# RATE_LIMIT_PER_MIN=10
# RATE_LIMIT_TOKEN_PER_MIN=30
# Durations use Go syntax: "90s", "15m", "1h".
# CODE_TTL=60s
# TOKEN_TTL=1h
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION=15m
# BCRYPT_COST=10
